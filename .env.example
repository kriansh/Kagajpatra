# AI — hosted Gemma via the Gemini API (optional; local Ollama works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-3-27b-it

# Local fallback (Ollama)
OLLAMA_URL=http://localhost:11434
# Preferred local model; falls back to gemma4:e4b, glm4:9b, qwen3.5:9b
OLLAMA_MODEL=gemma4:e2b

# Django
SECRET_KEY=change-me
DEBUG=True